**/*.pyc
**/__pycache__
**/.pytest_cache
# Evaluation harness: large regenerable sweep artefacts
results/**/aggregates.json
results/run*/
results/sweep_learners/per_seed.csv
results/sweep_discounted/per_seed.csv

# LaTeX build artefacts
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Compiled report PDFs (regenerable via pdflatex; figures in figures/ remain tracked)
Doc/report/*.pdf
!Doc/report/figures/*.pdf
!Doc/report/final_report.pdf

# Example outputs of run_tier1/2/3.py and run_demo.py (regenerable; not used by the report)
/tier*_benchmark*.json
/tier*_regret_curves.png
/tier*_convergence_plots.png
/demo.gif
*.nav
*.snm
*.toc
